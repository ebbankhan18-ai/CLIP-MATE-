# Copy this file to .env and fill it in.

# --- Who picks the best moments (choose ONE) -----------------------------
# Option A, FREE and local: install Ollama (ollama.com), run `ollama pull qwen2.5:7b-instruct`,
# then uncomment these two lines:
#LLM_PROVIDER=ollama
#OLLAMA_MODEL=qwen2.5:7b-instruct
# Option B, paid but higher quality: an Anthropic API key.
ANTHROPIC_API_KEY=
# With neither, a basic built-in heuristic is used, which is much weaker.
CLIP_LLM_MODEL=claude-sonnet-5-5

# Speech-to-text. tiny / base / small / medium / large-v3
# CPU laptop: small is a good balance. NVIDIA GPU: medium or large-v3.
WHISPER_MODEL=small

# Video encoder. libx264 works everywhere. With an NVIDIA GPU try h264_nvenc.
VIDEO_ENCODER=libx264

# YouTube publishing: OAuth "Desktop app" client file from Google Cloud.
YOUTUBE_CLIENT_SECRETS=client_secret.json

HOST=127.0.0.1
PORT=8000
